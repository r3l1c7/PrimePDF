<Window x:Class="PrimePdf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prime PDF" Height="880" Width="1360" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBack}"
        AllowDrop="True" Drop="OnWindowDrop" DragOver="OnWindowDragOver"
        FontFamily="{StaticResource UiFont}" FontSize="15">

    <!-- Snaps element edges to whole device pixels, so hairlines, borders and panel
         edges stay crisp at fractional display scaling instead of straddling pixels. -->
    <Grid x:Name="RootScale" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================== TOP BAR ========================== -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- App mark: gives the window an identity of its own, and matches the
                         icon that will sit on every PDF once this is the default reader. -->
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center" Margin="6,0,14,0" Effect="{StaticResource ShadowSoft}">
                        <Grid>
                            <Path Data="M8.4 5h5.6l2.6 2.6V19H8.4z" Fill="White" Stretch="Uniform"
                                  Width="17" Height="17" Margin="0,0,0,1"/>
                            <Rectangle Width="9" Height="2.6" Fill="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                        </Grid>
                    </Border>

                    <Button x:Name="BtnOpen" Style="{StaticResource ToolbarButton}" Click="OnOpen"
                            ToolTip="Open a PDF from your computer">
                        <StackPanel>
                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconOpen}"/>
                            <TextBlock Text="Open" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAddFiles" Style="{StaticResource ToolbarButton}" Click="OnAddFiles"
                            ToolTip="Add the pages of another PDF to the end of this one">
                        <StackPanel>
                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconAddFile}"/>
                            <TextBlock Text="Combine" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{StaticResource BorderBrush2}" Margin="8,10"/>

                    <Button x:Name="BtnUndo" Style="{StaticResource ToolbarButton}" Click="OnUndo" ToolTip="Undo the last change (Ctrl+Z)">
                        <StackPanel>
                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconUndo}"/>
                            <TextBlock Text="Undo" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnRedo" Style="{StaticResource ToolbarButton}" Click="OnRedo" ToolTip="Redo (Ctrl+Y)">
                        <StackPanel>
                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconRedo}"/>
                            <TextBlock Text="Redo" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnFind" Style="{StaticResource ToolbarButton}" Click="OnFind" ToolTip="Find words and black them out everywhere (Ctrl+F)">
                        <StackPanel>
                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconSearch}"/>
                            <TextBlock Text="Find" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0">
                    <TextBlock x:Name="TitleText" Text="Prime PDF" FontSize="16.5" FontWeight="SemiBold"
                               FontFamily="{StaticResource UiFontDisplay}" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                    <TextBlock x:Name="SubtitleText" Text="No file open yet" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnTextSize" Style="{StaticResource ToolbarButton}" Click="OnToggleUiScale"
                            ToolTip="Make everything in this app bigger or smaller">
                        <StackPanel>
                            <TextBlock Text="A" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TextSizeLabel" Text="Bigger" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSave" Style="{StaticResource PrimaryButton}" Click="OnSave" Margin="8,0,4,0"
                            ToolTip="Save your changes as a new file. The original is never overwritten.">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSave}" Stroke="White" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="21" Height="21" Margin="0,0,9,0"/>
                            <TextBlock Text="Save a Copy" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ BODY ============================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TOOL RAIL -->
            <Border Grid.Column="0" Width="98" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="RailPanel" Margin="0,10,0,10">

                        <ToggleButton x:Name="TogglePages" Style="{StaticResource RailToggle}" Click="OnTogglePages"
                                      ToolTip="Show page thumbnails so you can reorder, rotate or delete pages">
                            <StackPanel>
                                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconPages}"/>
                                <TextBlock Text="Pages" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </ToggleButton>

                        <Rectangle Height="1" Fill="{StaticResource BorderBrush2}" Margin="14,10"/>

                        <ToggleButton x:Name="ToolSelect" Style="{StaticResource RailToggle}" Tag="Select" Click="OnToolChanged"
                                      ToolTip="Just read the document without changing anything">
                            <StackPanel>
                                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconHand}"/>
                                <TextBlock Text="Read" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="ToolRedact" Style="{StaticResource RailToggle}" Tag="Redact" Click="OnToolChanged"
                                      ToolTip="Permanently remove words. Click a word, or drag a box.">
                            <StackPanel>
                                <Path Style="{StaticResource IconPathSolidStyle}" Data="{StaticResource IconRedact}"/>
                                <TextBlock Text="Black Out" HorizontalAlignment="Center" Margin="0,5,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="ToolEditText" Style="{StaticResource RailToggle}" Tag="EditText" Click="OnToolChanged"
                                      ToolTip="Click any words to correct them">
                            <StackPanel>
                                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconEditText}"/>
                                <TextBlock Text="Edit Text" HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="ToolSign" Style="{StaticResource RailToggle}" Tag="Sign" Click="OnToolChanged"
                                      ToolTip="Type into blanks, tick boxes, and add your signature">
                            <StackPanel>
                                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconSign}"/>
                                <TextBlock Text="Fill &amp; Sign" HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="ToolDraw" Style="{StaticResource RailToggle}" Tag="Draw" Click="OnToolChanged"
                                      ToolTip="Draw freely on the page with a pen">
                            <StackPanel>
                                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconDraw}"/>
                                <TextBlock Text="Draw" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="ToolHighlight" Style="{StaticResource RailToggle}" Tag="Highlight" Click="OnToolChanged"
                                      ToolTip="Highlight text in colour">
                            <StackPanel>
                                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconHighlight}"/>
                                <TextBlock Text="Highlight" HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="ToolErase" Style="{StaticResource RailToggle}" Tag="Erase" Click="OnToolChanged"
                                      ToolTip="Remove something you added">
                            <StackPanel>
                                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconErase}"/>
                                <TextBlock Text="Erase" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </ToggleButton>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- PAGES PANEL -->
            <Border x:Name="PagesPanel" Grid.Column="1" Width="228" Visibility="Collapsed"
                    Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" Padding="12,10"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="Pages" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Text="Drag a page to move it" Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" Padding="8,8"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
                        <UniformGrid Columns="5">
                            <Button Style="{StaticResource ToolbarButton}" Click="OnRotateLeft" ToolTip="Turn selected pages left" MinWidth="0" MinHeight="0" Padding="4,6">
                                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconRotateLeft}" Width="20" Height="20"/>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Click="OnRotateRight" ToolTip="Turn selected pages right" MinWidth="0" MinHeight="0" Padding="4,6">
                                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconRotateRight}" Width="20" Height="20"/>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Click="OnDuplicatePages" ToolTip="Make a copy of selected pages" MinWidth="0" MinHeight="0" Padding="4,6">
                                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconCopy}" Width="20" Height="20"/>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Click="OnExtractPages" ToolTip="Save selected pages as their own new PDF" MinWidth="0" MinHeight="0" Padding="4,6">
                                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconExtract}" Width="20" Height="20"/>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Click="OnDeletePages" ToolTip="Delete selected pages" MinWidth="0" MinHeight="0" Padding="4,6">
                                <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconTrash}" Width="20" Height="20" Stroke="{StaticResource DangerBrush}"/>
                            </Button>
                        </UniformGrid>
                    </Border>

                    <ScrollViewer x:Name="ThumbScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
                        <ItemsControl x:Name="ThumbList"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- CANVAS + OPTIONS -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="OptionsStrip" Grid.Row="0" Background="{StaticResource Surface}" Padding="14,9"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                    <StackPanel x:Name="OptionsHost" Orientation="Horizontal" VerticalAlignment="Center"/>
                </Border>

                <ScrollViewer x:Name="CanvasScroller" Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Background="{StaticResource CanvasBack}" Padding="0"
                              CanContentScroll="False"
                              ScrollChanged="OnCanvasScrollChanged"
                              PreviewMouseWheel="OnCanvasWheel">
                    <!-- Every page stacked in one column, so the wheel moves through the
                         whole document instead of the page buttons being the only way. -->
                    <StackPanel x:Name="PageColumn" Margin="36,28,36,28" HorizontalAlignment="Center"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ========================= STATUS BAR ========================= -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
            <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" VerticalAlignment="Center" Background="{StaticResource AccentSoftBrush}"
                        CornerRadius="10" Padding="15,10" HorizontalAlignment="Left" MaxWidth="620" x:Name="HintBubble">
                    <TextBlock x:Name="HintText" Text="Open a PDF to begin." FontSize="14" TextWrapping="Wrap"
                               Foreground="#1E40AF" LineHeight="19"/>
                </Border>

                <!-- Page and zoom read as two segmented controls rather than six loose buttons. -->
                <Border Grid.Column="1" Background="{StaticResource SurfaceAlt}" CornerRadius="21"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                        Padding="4" Margin="12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnPrev" Style="{StaticResource RoundIconButton}" Click="OnPrevPage" ToolTip="Previous page">
                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconPrev}" Width="19" Height="19"/>
                        </Button>
                        <TextBlock x:Name="PageLabel" Text="No pages" VerticalAlignment="Center" TextAlignment="Center"
                                   MinWidth="118" Margin="6,0" FontSize="14" FontWeight="Medium"/>
                        <Button x:Name="BtnNext" Style="{StaticResource RoundIconButton}" Click="OnNextPage" ToolTip="Next page">
                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconNext}" Width="19" Height="19"/>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource SurfaceAlt}" CornerRadius="21"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                        Padding="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnZoomOut" Style="{StaticResource RoundIconButton}" Click="OnZoomOut" ToolTip="Make the page smaller">
                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconMinus}" Width="19" Height="19"/>
                        </Button>
                        <TextBlock x:Name="ZoomLabel" Text="100%" MinWidth="56" TextAlignment="Center"
                                   VerticalAlignment="Center" Margin="4,0" FontSize="14" FontWeight="Medium"/>
                        <Button x:Name="BtnZoomIn" Style="{StaticResource RoundIconButton}" Click="OnZoomIn" ToolTip="Make the page bigger">
                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconPlus}" Width="19" Height="19"/>
                        </Button>
                        <Rectangle Width="1" Fill="{StaticResource BorderBrush2}" Margin="6,8"/>
                        <Button x:Name="BtnFit" Style="{StaticResource RoundIconButton}" Click="OnZoomFit" ToolTip="Fit the whole page on screen">
                            <Path Style="{StaticResource IconPathStyle}" Data="{StaticResource IconFit}" Width="19" Height="19"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ======================== START OVERLAY ======================== -->
        <Border x:Name="StartOverlay" Grid.Row="0" Grid.RowSpan="3" Background="{StaticResource CanvasBack}">
            <Border Style="{StaticResource CardBorder}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="56,48" MaxWidth="620">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.13" Color="#26303B"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="20" Width="88" Height="88" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconOpen}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stretch="Uniform" Width="46" Height="46"/>
                    </Border>

                    <TextBlock Text="Prime PDF" FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource UiFontDisplay}"
                               HorizontalAlignment="Center" Margin="0,24,0,0"/>
                    <TextBlock Text="Open a PDF to read it, black out private details, fix wording, sign it, or put pages in order."
                               FontSize="16" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,10,0,0" MaxWidth="440"/>

                    <Button Style="{StaticResource PrimaryButton}" Click="OnOpen" HorizontalAlignment="Center"
                            Margin="0,28,0,0" Padding="34,16" FontSize="17">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconOpen}" Stroke="White" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="24" Height="24" Margin="0,0,12,0"/>
                            <TextBlock Text="Choose a PDF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="&#8230;or drag a PDF file onto this window"
                               Foreground="{StaticResource MutedBrush}" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,18,0,0"/>

                    <Button x:Name="DefaultAppLink" Style="{StaticResource LinkButton}"
                            Content="Make Prime PDF open all my PDF files"
                            Click="OnMakeDefaultApp" HorizontalAlignment="Center" Margin="0,10,0,0"
                            Visibility="Collapsed"
                            ToolTip="Registers this app with Windows, then lets you confirm the change"/>

                    <Border Background="{StaticResource SurfaceAlt}" CornerRadius="10" Padding="16,12" Margin="0,26,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13.5" MaxWidth="420"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="Your original file is never changed. Every save creates a new copy, so you can always start again."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Border>

        <!-- ========================== BUSY VEIL ========================== -->
        <Border x:Name="BusyVeil" Grid.Row="0" Grid.RowSpan="3" Background="#99101418" Visibility="Collapsed">
            <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="40,32"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="BusyText" Text="Working&#8230;" FontSize="18" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Height="6" Width="240" Margin="0,18,0,0"
                                 Background="{StaticResource SurfaceAlt}" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>


<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <!-- ============================ palette ============================
         Neutrals carry a little blue so the greys read as considered rather
         than washed out, and the accent is used sparingly: one primary action,
         the selected tool, and focus. -->
    <Color x:Key="CanvasBackColor">#E4E8EE</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F4F6F9</Color>
    <Color x:Key="BorderColor">#DFE4EB</Color>
    <Color x:Key="BorderStrongColor">#C7CFDA</Color>
    <Color x:Key="TextColor">#101828</Color>
    <Color x:Key="MutedColor">#667085</Color>
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentDarkColor">#1D4ED8</Color>
    <Color x:Key="AccentSoftColor">#EFF4FF</Color>
    <Color x:Key="AccentSoftStrongColor">#DBE7FE</Color>
    <Color x:Key="DangerColor">#D92D20</Color>
    <Color x:Key="DangerSoftColor">#FEF3F2</Color>
    <Color x:Key="SuccessColor">#079455</Color>
    <Color x:Key="WarningColor">#B54708</Color>

    <SolidColorBrush x:Key="CanvasBack" Color="{StaticResource CanvasBackColor}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="AccentSoftStrong" Color="{StaticResource AccentSoftStrongColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EDF0F5"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#E2E7EF"/>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="UiFontDisplay">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>

    <!-- Two-layer shadow: a tight contact shadow plus a wide soft one. A single
         blur always looks like a smudge; two look like the object has weight. -->
    <DropShadowEffect x:Key="ShadowSoft" BlurRadius="18" ShadowDepth="2" Opacity="0.10" Color="#0F1A2B"/>
    <DropShadowEffect x:Key="ShadowCard" BlurRadius="30" ShadowDepth="6" Opacity="0.13" Color="#0F1A2B"/>
    <DropShadowEffect x:Key="ShadowPage" BlurRadius="24" ShadowDepth="4" Opacity="0.16" Color="#0F1A2B"/>

    <!-- =============================== icons ===============================
         All drawn on the same 24x24 grid with a 1.8 stroke and round caps, so
         they sit at one optical weight instead of each being its own doodle. -->
    <Geometry x:Key="IconOpen">M3.6 7.9a1.9 1.9 0 0 1 1.9-1.9h3.6l2 2.4h7.4a1.9 1.9 0 0 1 1.9 1.9v7.8a1.9 1.9 0 0 1-1.9 1.9H5.5a1.9 1.9 0 0 1-1.9-1.9z</Geometry>
    <Geometry x:Key="IconAddFile">M13.4 3.6H7.6a2 2 0 0 0-2 2v12.8a2 2 0 0 0 2 2h8.8a2 2 0 0 0 2-2V8.5zM13.4 3.6v4.9h5M12 12.2v5M9.5 14.7h5</Geometry>
    <Geometry x:Key="IconSave">M12 3.8v10.4M8.3 10.6l3.7 3.6 3.7-3.6M4.8 16.6v1.8a2 2 0 0 0 2 2h10.4a2 2 0 0 0 2-2v-1.8</Geometry>
    <Geometry x:Key="IconUndo">M4.4 9.8h9.4a5.1 5.1 0 0 1 0 10.2H9.2M4.4 9.8l3.9-3.9M4.4 9.8l3.9 3.9</Geometry>
    <Geometry x:Key="IconRedo">M19.6 9.8h-9.4a5.1 5.1 0 0 0 0 10.2h4.6M19.6 9.8l-3.9-3.9M19.6 9.8l-3.9 3.9</Geometry>
    <Geometry x:Key="IconSearch">M10.9 4.7a6.1 6.1 0 1 0 0 12.2 6.1 6.1 0 0 0 0-12.2zM15.4 15.4l4.2 4.2</Geometry>

    <!-- Read: an eye says "just looking" far more directly than a hand. -->
    <Geometry x:Key="IconHand">M2.8 12S6.3 5.9 12 5.9 21.2 12 21.2 12 17.7 18.1 12 18.1 2.8 12 2.8 12zM12 9.3a2.7 2.7 0 1 0 0 5.4 2.7 2.7 0 0 0 0-5.4z</Geometry>

    <!-- Black Out: lines of text with a solid bar through them. The bar is a
         closed subpath so it fills; the two lines are open so they only stroke. -->
    <Geometry x:Key="IconRedact">M4.6 6.9h14.8M4 10.7h16v2.9H4zM4.6 17.4h8.6</Geometry>

    <!-- Edit Text: a pencil working on a baseline. -->
    <Geometry x:Key="IconEditText">M4.2 20.2h15.6M7 16.4l.9-3.3 7.7-7.7a1.5 1.5 0 0 1 2.1 0l1.2 1.2a1.5 1.5 0 0 1 0 2.1l-7.7 7.7zM14.4 6.2l3.3 3.3</Geometry>

    <!-- Fill &amp; Sign: a signature flourish over a ruled line. -->
    <Geometry x:Key="IconSign">M3.8 16.6c2.9 0 3.2-9.4 5.7-9.4s1.4 7.8 3.4 7.8 1.9-4.2 3.4-4.2 1.4 1.6 2.9 1.6M4 20.4h16</Geometry>

    <!-- Draw: a bare freehand wave. Edit Text already owns the pencil, and two
         pencils side by side in the rail told the user nothing. -->
    <Geometry x:Key="IconDraw">M3.4 15.2c1.7-5.2 3.4-5.2 5.1 0s3.4 5.2 5.1 0 3.4-5.2 5.1-1.4</Geometry>

    <!-- Highlight: a chisel marker above the band it leaves. -->
    <Geometry x:Key="IconHighlight">M8.6 15.9 5.9 13.2l7.6-7.6a1.4 1.4 0 0 1 2 0l.7.7a1.4 1.4 0 0 1 0 2zM6.2 19.4h4.4l-1.6-1.6-2.8-2.8-1.4 1.9zM13.8 19.4h5.9</Geometry>

    <Geometry x:Key="IconErase">M8.4 20.4h10.8M6.7 18.2l-2.5-2.5a1.9 1.9 0 0 1 0-2.8l8-8a1.9 1.9 0 0 1 2.8 0l4.1 4.1a1.9 1.9 0 0 1 0 2.8l-6.5 6.4zM9.6 9.6l5.6 5.6</Geometry>
    <Geometry x:Key="IconPages">M4.6 4.6h5.7v5.7H4.6zM13.7 4.6h5.7v5.7h-5.7zM4.6 13.7h5.7v5.7H4.6zM13.7 13.7h5.7v5.7h-5.7z</Geometry>

    <Geometry x:Key="IconPrev">M14.8 5.4 8.2 12l6.6 6.6</Geometry>
    <Geometry x:Key="IconNext">M9.2 5.4 15.8 12l-6.6 6.6</Geometry>
    <Geometry x:Key="IconPlus">M12 5.6v12.8M5.6 12h12.8</Geometry>
    <Geometry x:Key="IconMinus">M5.6 12h12.8</Geometry>
    <Geometry x:Key="IconFit">M4.6 9.4V5.9a1.3 1.3 0 0 1 1.3-1.3h3.5M19.4 9.4V5.9a1.3 1.3 0 0 0-1.3-1.3h-3.5M4.6 14.6v3.5a1.3 1.3 0 0 0 1.3 1.3h3.5M19.4 14.6v3.5a1.3 1.3 0 0 1-1.3 1.3h-3.5</Geometry>
    <Geometry x:Key="IconRotateRight">M20.2 12a8.2 8.2 0 1 1-2.4-5.8M20.4 4.1v4.6h-4.6</Geometry>
    <Geometry x:Key="IconRotateLeft">M3.8 12a8.2 8.2 0 1 0 2.4-5.8M3.6 4.1v4.6h4.6</Geometry>
    <Geometry x:Key="IconTrash">M4.6 6.9h14.8M9.6 6.9V5.2a1.3 1.3 0 0 1 1.3-1.3h2.2a1.3 1.3 0 0 1 1.3 1.3v1.7M6.7 6.9l.9 12.1a1.4 1.4 0 0 0 1.4 1.3h6a1.4 1.4 0 0 0 1.4-1.3l.9-12.1M10.2 10.6v6M13.8 10.6v6</Geometry>
    <Geometry x:Key="IconCopy">M9.4 9.4h9.2a1.4 1.4 0 0 1 1.4 1.4v9.2h-9.2a1.4 1.4 0 0 1-1.4-1.4zM14.6 5.4v-.6a1.4 1.4 0 0 0-1.4-1.4H4.8a1.4 1.4 0 0 0-1.4 1.4v8.4a1.4 1.4 0 0 0 1.4 1.4h.6</Geometry>
    <Geometry x:Key="IconClose">M6.6 6.6 17.4 17.4M17.4 6.6 6.6 17.4</Geometry>
    <Geometry x:Key="IconCheck">M5.2 12.6 9.6 17 18.8 7.4</Geometry>
    <Geometry x:Key="IconExtract">M12 3.8v9.4M8.3 9.6l3.7 3.6 3.7-3.6M4.8 15.6v2.8a2 2 0 0 0 2 2h10.4a2 2 0 0 0 2-2v-2.8</Geometry>

    <!-- ============================ icon styles ============================
         Icons take their colour from the button they sit in, so a selected tool
         tints its icon without every call site having to say so. -->
    <Style x:Key="IconPathStyle" TargetType="Path">
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type prim:ButtonBase}},
                                FallbackValue={StaticResource TextBrush}, TargetNullValue={StaticResource TextBrush}}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="25"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Same, but closed subpaths fill solid — used by the Black Out bar. -->
    <Style x:Key="IconPathSolidStyle" TargetType="Path" BasedOn="{StaticResource IconPathStyle}">
        <Setter Property="Fill"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type prim:ButtonBase}},
                                FallbackValue={StaticResource TextBrush}, TargetNullValue={StaticResource TextBrush}}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- ============================= scrollbars ============================= -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="tb" Background="#B2BCC9" CornerRadius="6" Margin="3,2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="tb" Property="Background" Value="#8A97A8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="13"/>
                            <Setter Property="Width" Value="Auto"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =============================== buttons =============================== -->

    <Style x:Key="ToolbarButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="58"/>
        <Setter Property="MinWidth" Value="66"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource PressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.32"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="46"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                            Effect="{StaticResource ShadowSoft}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                            BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAlt}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
    </Style>

    <!-- Round icon button used for page navigation and zoom. -->
    <Style x:Key="RoundIconButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="20"
                            BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Left rail tool. Selected state is a soft tint with an accent spine and a
         tinted icon, which reads as clearly as a solid blue block without
         shouting over the document the tools are meant to serve. -->
    <Style x:Key="RailToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="9,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="11" Padding="4,10"/>
                        <!-- Sits on the pill's own left edge, not outside it: at the rail
                             boundary the window clips it and it reads as a glitch. -->
                        <Border x:Name="spine" Width="3" Height="28" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="Transparent"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,10"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            <Setter TargetName="spine" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="MinWidth" Value="42"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{StaticResource Surface}" CornerRadius="18"
                            BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" Padding="12,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAlt}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="12,8">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}" FontWeight="Medium"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="13,10"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1.3"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="White" CornerRadius="10"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#101828" CornerRadius="8" Padding="12,8" Effect="{StaticResource ShadowSoft}">
                        <ContentPresenter TextBlock.Foreground="White" TextBlock.FontSize="13.5"
                                          TextBlock.FontFamily="{StaticResource UiFont}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
